{
  "info": {
    "name": "LeadLoop Leads + Scoring API",
    "description": "Mock-data-only collection. Run after docker compose up --build and applying db/leads.sql.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "leadId",
      "value": "1"
    },
    {
      "key": "ruleId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (set token manually from response)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Replace password with your local development admin password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"CHANGE_ME\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Leads (mock data only)",
      "item": [
        {
          "name": "Create mock lead with explicit consent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads"
              ]
            },
            "description": "Fictitious data only. General consent is required.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campaign_id\": null,\n  \"display_name\": \"ลูกค้าทดสอบ 001\",\n  \"channel\": \"mock\",\n  \"channel_user_id\": \"mock-user-001\",\n  \"budget\": 12900,\n  \"consent_general\": true,\n  \"consent_marketing\": false,\n  \"consent_version\": \"mock-v1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List leads",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads?channel=mock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads"
              ],
              "query": [
                {
                  "key": "channel",
                  "value": "mock",
                  "disabled": false
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get lead details and score breakdown",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{leadId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Add mock event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{leadId}}",
                "events"
              ]
            },
            "description": "Event names are listed in docs/LEADS_API.md.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"asked_price\",\n  \"data\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Detect events from mock text (text is not stored)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}/message",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{leadId}}",
                "message"
              ]
            },
            "description": "Only detected event types are stored, not the submitted text.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"ขอรายละเอียดหน่อย ราคาเท่าไหร่\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Grant marketing consent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}/consent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{leadId}}",
                "consent"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"marketing\",\n  \"action\": \"granted\",\n  \"text_version\": \"mock-v1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Withdraw marketing consent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}/consent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{leadId}}",
                "consent"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"marketing\",\n  \"action\": \"withdrawn\",\n  \"text_version\": \"mock-v1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Export lead (admin only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}/export",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{leadId}}",
                "export"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Anonymize lead (admin only; destructive)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{leadId}}"
              ]
            },
            "description": "Destructive to this mock lead only; clears legacy name/contact and removes events."
          }
        }
      ]
    },
    {
      "name": "Scoring rules (mock data)",
      "item": [
        {
          "name": "List scoring rules",
          "request": {
            "method": "GET",
            "header": [
