# Copy to .env on the server and fill in EVERY value. Never commit .env (it is in .gitignore).

# public address: a domain name gives automatic HTTPS; use :80 only for a local trial
SITE_ADDRESS=leadloop.example.com
APP_BASE_URL=https://leadloop.example.com

# database (use a long random password: at least 24 characters)
POSTGRES_USER=leadloop
POSTGRES_PASSWORD=
POSTGRES_DB=leadloop

# login tokens: a long random string, at least 32 characters. Changing it logs everyone out.
JWT_SECRET=

# first admin account, created at the first start. Use a strong password, then change it on first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# optional: only people with these email domains can be invited, e.g. vannessplus.com
ALLOWED_EMAIL_DOMAINS=

# AI providers (campaign/product facts only; no customer data is sent). Leave blank to use the built-in templates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDERS=claude,gemini
AI_DAILY_QUOTA_PER_USER=30
AI_DAILY_TOKEN_CAP=0
AI_RETRY_MAX=5

# daily job (silent leads and follow-up drafts), hour in Thailand time
DAILY_JOB_HOUR=9
DAILY_JOB_DISABLED=

# public customer chat page (/chat): OFF unless 1. Keep it off for real use until the PDPA items are approved.
PUBLIC_CHAT_ENABLED=
PUBLIC_CHAT_MAX_LEADS_PER_HOUR=100
# shown in the consent notice
PRIVACY_POLICY_URL=
PDPA_RETENTION_TEXT=

# LINE Official Account: OFF unless BOTH the secret and the token are set (LINE Developers > Messaging API).
# Webhook URL to give LINE: https://<public address>/api/public/line/webhook  (dev through a tunnel: https://<tunnel>/public/line/webhook)
# LINE_CAMPAIGN_ID: campaign number that new LINE leads are attached to (optional).
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CAMPAIGN_ID=
# LINE_IMAGE_BASE_URL: public https address LINE uses to fetch product pictures (empty = APP_BASE_URL). Needs PUBLIC_CHAT_ENABLED=1.
#   LINE accepts only JPEG/PNG up to 1 MB over https; otherwise the bot sends text only.
# LINE_PUSH_RESERVE: monthly LINE messages kept free for salespeople answering by hand; approved follow-up drafts stop
#   being sent when the remaining quota is at or below this number.
LINE_IMAGE_BASE_URL=
LINE_PUSH_RESERVE=20

# lead hand-off: a lead that becomes ready is given to a salesperson automatically unless AUTO_ASSIGN=0.
# NOTIFY_WEBHOOK_URL (optional): a Slack/Discord-style webhook that gets one short line per ready lead (lead number and
# score only, no customer data). Leave blank for no outside notification.
AUTO_ASSIGN=
NOTIFY_WEBHOOK_URL=

# PDPA: automatic clean-up of leads, in days. 0 = OFF (nothing is ever deleted automatically). These are the
# starting values: an admin can change them on the settings page, and the page also shows a preview before anything
# is deleted. Do NOT set them until the company has decided the retention period.
RETENTION_INACTIVE_DAYS=0
RETENTION_WITHDRAWN_DAYS=0
# version label stored with each consent; change it (e.g. v3) when the consent notice text changes. Blank = built-in.
CONSENT_VERSION=
