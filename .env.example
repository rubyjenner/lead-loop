POSTGRES_USER=leadloop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadloop
ANTHROPIC_API_KEY=

# optional second AI provider (used when Claude fails). Free-tier Gemini may use prompts to improve Google products: send only campaign/product facts, never customer data
GEMINI_API_KEY=

# Gemini model names change often (gemini-2.5-* returned 404 for a new key on 26 Oct 2026). List the models your key can call: GET https://generativelanguage.googleapis.com/v1beta/models with the x-goog-api-key header
GEMINI_MODEL=gemini-3.5-flash-lite

# order of AI providers; the rule/template fallback always runs last. Use AI_PROVIDERS=template to turn external AI off
AI_PROVIDERS=claude,gemini

# daily AI limits (0 = off). When a limit is reached the request is still served by the template algorithm
AI_DAILY_QUOTA_PER_USER=30
AI_DAILY_TOKEN_CAP=0

# how many times a failed AI request is retried in the background (1 min, 5 min, 15 min, 1 h, 3 h)
AI_RETRY_MAX=5

# web origins allowed to call the API from a browser, e.g. https://app.example.com (empty = CORS off)
CORS_ORIGINS=

# set to X-Forwarded-For ONLY when the API is reachable solely through a reverse proxy (Caddy); empty otherwise
PROXY_HEADER=

# address of the web app, used to build invite / forgot-password links (e.g. https://leadloop.example.com). Empty = links are returned as /set-password?token=...
APP_BASE_URL=

# optional: only these email domains may be given an account, comma separated (e.g. vannessplus.com). Empty = any domain
ALLOWED_EMAIL_DOMAINS=

# generate: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# used only to create the first admin when the users table is empty
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
